# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Provider Configuration
PREFERRED_PROVIDER=openai  # Options: openai, google, anthropic

# Model Mapping
BIG_MODEL=gpt-4o           # Model to use for Claude Sonnet/Opus
SMALL_MODEL=gpt-4o-mini    # Model to use for Claude Haiku

# OpenAI Configuration (optional)
OPENAI_BASE_URL=https://api.openai.com/v1

# Vertex AI Configuration (for Google Gemini)
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1
USE_VERTEX_AUTH=false  # Set to true to use Vertex AI authentication instead of API key

# Global Default Context Limits (optional)
# Use these when your model is not recognized by litellm
# If not set, litellm's built-in model database will be used
# DEFAULT_MAX_INPUT_TOKENS=128000
# DEFAULT_MAX_OUTPUT_TOKENS=16384

# Retry Configuration
LITELLM_MAX_RETRIES=3
LITELLM_RETRY_BASE_DELAY=2

# Test Mode (for development)
CC_TRACE_ECHO_ONLY=false

# Server Configuration
PORT=8082
WORKERS=16
BACKLOG=2048
# LIMIT_CONCURRENCY=100
