# ============================================================
# Claude Code Proxy — 环境变量配置
# ============================================================
# 复制此文件为 .env 后修改:  cp .env.example .env
# ============================================================

# ============================================================
# 一、API 密钥（按需填写，不用全部填）
# ============================================================

# Anthropic API Key — 仅在以下两种情况需要:
#   1. PREFERRED_PROVIDER=anthropic（直通模式，用真正的 Claude 模型）
#   2. 作为 LiteLLM 的 fallback 认证
# 如果你只用 OpenAI 或 Gemini，可以不填
ANTHROPIC_API_KEY="your-anthropic-api-key"

# OpenAI API Key — 以下情况需要:
#   1. PREFERRED_PROVIDER=openai（默认，最常用）
#   2. 使用任何 openai/ 前缀的模型
# 格式示例: sk-proj-... 或 sk-...
OPENAI_API_KEY="sk-..."

# Gemini API Key — 以下情况需要:
#   1. PREFERRED_PROVIDER=google 且 USE_VERTEX_AUTH=false（使用 API Key 方式）
#   2. 使用任何 gemini/ 前缀的模型
# 获取地址: https://aistudio.google.com/apikey
# 注意: 如果 USE_VERTEX_AUTH=true，则不需要此 Key（走 ADC 认证）
GEMINI_API_KEY="your-google-ai-studio-key"


# ============================================================
# 二、提供商偏好 & 模型映射（核心配置）
# ============================================================

# PREFERRED_PROVIDER — 决定 Claude Code 的 haiku/sonnet 映射到哪家模型
# 可选值:
#   openai    (默认) — haiku→SMALL_MODEL, sonnet→BIG_MODEL，前缀 openai/
#   google           — haiku→SMALL_MODEL, sonnet→BIG_MODEL，前缀 gemini/
#   anthropic        — 不做映射，原样转发给 Anthropic API（直通模式）
PREFERRED_PROVIDER="openai"

# OPENAI_BASE_URL — OpenAI 兼容 API 的基础地址
# 默认是 https://api.openai.com/v1
# 如果你用的是 OpenAI 兼容的第三方服务，改这里:
#   阿里云百炼:  https://dashscope.aliyuncs.com/compatible-mode/v1
#   DeepSeek:    https://api.deepseek.com
#   其他兼容服务: 填对应地址即可
OPENAI_BASE_URL="https://api.openai.com/v1"

# BIG_MODEL — 对应 Claude Sonnet 级别（大模型/强模型）
# 当 Claude Code 请求 sonnet 系列模型时，实际调用此模型
#   PREFERRED_PROVIDER=openai 时默认: gpt-4.1
#   PREFERRED_PROVIDER=google 时默认: gemini-2.5-pro
#   PREFERRED_PROVIDER=anthropic 时: 忽略此参数（不做映射）
# BIG_MODEL="gpt-4.1"

# SMALL_MODEL — 对应 Claude Haiku 级别（小模型/快模型）
# 当 Claude Code 请求 haiku 系列模型时，实际调用此模型
#   PREFERRED_PROVIDER=openai 时默认: gpt-4.1-mini
#   PREFERRED_PROVIDER=google 时默认: gemini-2.5-flash
#   PREFERRED_PROVIDER=anthropic 时: 忽略此参数（不做映射）
# SMALL_MODEL="gpt-4.1-mini"


# ============================================================
# 三、Vertex AI 认证（仅 Gemini + Google Cloud 用户需要）
# ============================================================

# USE_VERTEX_AUTH — 是否使用 Google Cloud 的 ADC (Application Default Credentials)
# 设为 true 后不需要 GEMINI_API_KEY，改用 gcloud 的 ADC 认证
# 前提: 已安装 gcloud CLI 并执行过 gcloud auth application-default login
USE_VERTEX_AUTH="False"

# VERTEX_PROJECT — Google Cloud 项目 ID
# 仅 USE_VERTEX_AUTH=true 时需要
# VERTEX_PROJECT="your-gcp-project-id"

# VERTEX_LOCATION — Google Cloud 区域
# 仅 USE_VERTEX_AUTH=true 时需要
# 常用区域: us-central1, asia-northeast1, europe-west4
# VERTEX_LOCATION="us-central1"


# ============================================================
# 四、Anthropic 服务地址（直通模式使用）
# ============================================================

# ANTHROPIC_BASE_URL — Anthropic API 的基础地址
# 仅在 PREFERRED_PROVIDER=anthropic 或模型以 anthropic/ 开头时生效
# 默认是官方 Anthropic API，也可以改成兼容服务:
#   DeepSeek 的 Anthropic 兼容端点: https://api.deepseek.com/anthropic
ANTHROPIC_BASE_URL="https://api.anthropic.com"


# ============================================================
# 五、模型上下文限制（可选覆盖）
# ============================================================

# 当 LiteLLM 查不到某个模型的 context window 信息时，用这些值作为 fallback
# 一般不需要设置，除非你用的模型比较新、LiteLLM 还没收录
# DEFAULT_MAX_INPUT_TOKENS=200000
# DEFAULT_MAX_OUTPUT_TOKENS=16384


# ============================================================
# 六、服务运行参数
# ============================================================

# PORT — 服务监听端口，默认 8082
# PORT=8082

# WORKERS — worker 进程数，默认 16
# 每个 worker 是独立进程，能真正利用多核 CPU
# 设 1 便于调试，设 4~16 适合生产环境
# WORKERS=16

# BACKLOG — TCP 连接队列大小，默认 2048
# BACKLOG=2048

# LIMIT_CONCURRENCY — 每个 worker 的最大并发请求数
# 不设则不限制；设一个值可以在高负载时保护服务不被打垮
# LIMIT_CONCURRENCY=100


# ============================================================
# 七、重试配置
# ============================================================

# LITELLM_MAX_RETRIES — 上游调用失败时的最大重试次数，默认 3
# 遇到限流(429)、服务器错误(5xx)、超时等临时错误会自动重试
# LITELLM_MAX_RETRIES=3

# LITELLM_RETRY_BASE_DELAY — 重试基础等待秒数，默认 2
# 重试间隔按指数增长: 2s → 4s → 8s
# LITELLM_RETRY_BASE_DELAY=2


# ============================================================
# 八、追踪配置
# ============================================================

# CC_TRACE_ENABLED — 是否开启请求追踪记录，默认 true
# 关掉后不再写入 trace.db，适合不想产生磁盘写入的场景
# CC_TRACE_ENABLED=true

# CC_TRACE_DIR — 追踪数据库存放目录，默认项目根目录
# CC_TRACE_DIR=cc_traces

# CC_TRACE_ECHO_ONLY — 测试模式，不真正调用 AI 模型
# 设为 true 后所有请求直接返回假的 "TRACE_GATEWAY_ECHO_OK" 回复
# 适合测试追踪功能、调试 UI，不会产生 API 费用
# CC_TRACE_ECHO_ONLY=false

# CC_TRACE_INCLUDE_SYSTEM_IN_PREFIX — 是否把 system prompt 纳入前缀哈希
# 默认 false，只在会话消息层面计算前缀
# CC_TRACE_INCLUDE_SYSTEM_IN_PREFIX=false


# ============================================================
# 九、常见使用场景速查
# ============================================================

# 场景 1: 用 OpenAI GPT 替代 Claude（最常用）
#   PREFERRED_PROVIDER=openai
#   OPENAI_API_KEY=sk-...
#   BIG_MODEL=gpt-4.1
#   SMALL_MODEL=gpt-4.1-mini
#   （其他不需要填）

# 场景 2: 用 Google Gemini 替代 Claude（API Key 方式）
#   PREFERRED_PROVIDER=google
#   GEMINI_API_KEY=your-key
#   BIG_MODEL=gemini-2.5-pro
#   SMALL_MODEL=gemini-2.5-flash

# 场景 3: 用 Google Gemini 替代 Claude（Vertex AI / ADC 方式）
#   PREFERRED_PROVIDER=google
#   USE_VERTEX_AUTH=true
#   VERTEX_PROJECT=your-project-id
#   VERTEX_LOCATION=us-central1
#   BIG_MODEL=gemini-2.5-pro
#   SMALL_MODEL=gemini-2.5-flash

# 场景 4: 纯 Anthropic 代理（用真正的 Claude，只做追踪）
#   PREFERRED_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#   （BIG_MODEL / SMALL_MODEL 会被忽略）

# 场景 5: 用阿里云百炼的通义千问
#   PREFERRED_PROVIDER=openai
#   OPENAI_API_KEY=sk-你的阿里云key
#   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   BIG_MODEL=qwen-plus
#   SMALL_MODEL=qwen-turbo

# 场景 6: 测试追踪功能（不花钱调 API）
#   CC_TRACE_ECHO_ONLY=true
#   （不需要填任何 API Key）
